# MPLADSentinel — example environment configuration
# Copy to `.env` and adjust locally. `.env` is git-ignored and must never be committed.
# This file lists variable NAMES and safe placeholder values only — no real secrets.

# ----------------------------------------------------------------------------
# Backend (Spring Boot) — consumed by backend/src/main/resources/application.yml
# ----------------------------------------------------------------------------

# PostgreSQL connection. Host port 5544 matches the docker-compose Postgres
# (chosen to avoid colliding with a native PostgreSQL on 5432).
MPLADS_DB_URL=jdbc:postgresql://localhost:5544/mpladsentinel
MPLADS_DB_USERNAME=mpladsentinel
MPLADS_DB_PASSWORD=change-me-locally

# HTTP server (8081 by default; 8080 is often used by other local apps)
MPLADS_SERVER_PORT=8081

# Comma-separated list of allowed browser origins for CORS (frontend dev server)
MPLADS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Active Spring profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Round 1 authentication (decision D31): seeded demo accounts, one per web role
# (usernames: mospi, state, district, auditor, mp, citizen).
# Set to false where login accounts are provisioned another way.
MPLADS_AUTH_SEEDING_ENABLED=true
# Shared password for the seeded demo accounts. Local-dev convenience only
# (same class of value as MPLADS_DB_PASSWORD); it is BCrypt-hashed before storage.
MPLADS_AUTH_SEED_PASSWORD=Demo@12345

# Empowered Indian MPLADS API (secondary data-access source; public, no auth).
# All optional — the application.yml defaults are used when these are unset.
MPLADS_EI_BASE_URL=https://api.empoweredindian.in/api
MPLADS_EI_CONNECT_TIMEOUT=5s
MPLADS_EI_READ_TIMEOUT=15s
MPLADS_EI_MAX_ATTEMPTS=3
MPLADS_EI_RETRY_DELAY=500ms
MPLADS_EI_DEFAULT_PAGE_SIZE=20

# Ingestion pipeline (Phase 2E-2; manual trigger only, no scheduler).
# All optional — application.yml defaults are conservative.
MPLADS_INGEST_WORKS_PAGE_SIZE=100
MPLADS_INGEST_WORKS_MAX_PAGES=6000
MPLADS_INGEST_WORKS_INTER_PAGE_DELAY=0ms
MPLADS_INGEST_DEAD_LETTER_CAP=500
MPLADS_INGEST_PARTIAL_ON_DEAD_LETTERS=false
MPLADS_INGEST_PAYMENTS_MAX_WORKS=200
MPLADS_INGEST_PAYMENTS_DELAY=200ms
MPLADS_INGEST_PAYMENTS_RECHECK_ABSENT=7d
MPLADS_INGEST_PAYMENTS_RECHECK_PRESENT=30d
# Dev/demo only: ingestion steps to run once at backend startup so the /api/works
# APIs have data. Comma-separated, any of: recommended, completed, payments, sample.
# Empty = do nothing.
#   recommended/completed = sequential pages (state-alphabetical; bounded by
#     MPLADS_INGEST_WORKS_MAX_PAGES) — a small run only reaches the first few states.
#   sample = first N pages of recommended+completed per state — geographically diverse.
MPLADS_INGEST_RUN_ON_STARTUP=
# "sample" step tuning (defaults in application.yml; state list is the 28 states + main UTs).
MPLADS_INGEST_SAMPLE_PAGES_PER_STATE=1
# MPLADS_INGEST_SAMPLE_STATES=Kerala,Bihar,Maharashtra   # override the default list

# ----------------------------------------------------------------------------
# Local Postgres container (docker-compose.yml)
# ----------------------------------------------------------------------------
POSTGRES_DB=mpladsentinel
POSTGRES_USER=mpladsentinel
POSTGRES_PASSWORD=change-me-locally
# Host port the container publishes on (container side stays 5432).
POSTGRES_PORT=5544

# ----------------------------------------------------------------------------
# Frontend (Vite) — see frontend/.env.example for the authoritative list.
# Vite only exposes variables prefixed with VITE_ to client code.
# ----------------------------------------------------------------------------
VITE_API_BASE_URL=/api
