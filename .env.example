# MPLADSentinel — example environment configuration
# Copy to `.env` and adjust locally. `.env` is git-ignored and must never be committed.
# This file lists variable NAMES and safe placeholder values only — no real secrets.

# ----------------------------------------------------------------------------
# Backend (Spring Boot) — consumed by backend/src/main/resources/application.yml
# ----------------------------------------------------------------------------

# PostgreSQL connection. Host port 5544 matches the docker-compose Postgres
# (chosen to avoid colliding with a native PostgreSQL on 5432).
MPLADS_DB_URL=jdbc:postgresql://localhost:5544/mpladsentinel
MPLADS_DB_USERNAME=mpladsentinel
MPLADS_DB_PASSWORD=change-me-locally

# HTTP server (8081 by default; 8080 is often used by other local apps)
MPLADS_SERVER_PORT=8081

# Comma-separated list of allowed browser origins for CORS (frontend dev server)
MPLADS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Active Spring profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# ----------------------------------------------------------------------------
# Local Postgres container (docker-compose.yml)
# ----------------------------------------------------------------------------
POSTGRES_DB=mpladsentinel
POSTGRES_USER=mpladsentinel
POSTGRES_PASSWORD=change-me-locally
# Host port the container publishes on (container side stays 5432).
POSTGRES_PORT=5544

# ----------------------------------------------------------------------------
# Frontend (Vite) — see frontend/.env.example for the authoritative list.
# Vite only exposes variables prefixed with VITE_ to client code.
# ----------------------------------------------------------------------------
VITE_API_BASE_URL=/api
