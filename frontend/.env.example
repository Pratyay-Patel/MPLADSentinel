# Frontend environment (Vite). Copy to `.env` for local overrides.
# Only variables prefixed with VITE_ are exposed to client code.

# Base path/URL the app uses for backend API calls.
# Default is the relative "/api" path, which the Vite dev server proxies to the
# Spring Boot backend (see vite.config.ts). The frontend must never call
# external MPLADS / third-party APIs directly.
VITE_API_BASE_URL=/api

# Optional: override the backend target the Vite dev server proxies to.
VITE_DEV_API_PROXY_TARGET=http://localhost:8081

# Which data provider the frontend uses:
#   demo -> local demo fixtures (default; lets the UI be built before backend APIs land)
#   api  -> real data via the Spring Boot backend (only endpoints that exist are wired)
VITE_DATA_SOURCE=demo

# "true" runs the frontend with NO backend: the session is chosen from a persona
# picker and held client-side (used for the standalone Vercel demo build via
# `npm run build:demo` / .env.demo). Leave unset for normal development.
# VITE_DEMO_AUTH=true
